CAPITAL_API_KEY=
CAPITAL_EMAIL=
CAPITAL_PASSWORD=
CAPITAL_BASE_URL=
CAPITAL_BASE_DEMO_URL=
DISCORD_WEBHOOK_URL=
IS_DEMO=true

# Optional strategy knobs - unset falls back to the code defaults (baseline
# strategy, 1% risk, BALANCE_CAP=1000). See config.py.
STRATEGY=
VOL_REGIME_MIN=
VOL_MANAGED_SIZING=
RISK_PER_TRADE=
BALANCE_CAP=

# discord_bot.py only (separate process, not used by bot.py)
DISCORD_BOT_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_ACCESS_TOKEN=
# Comma-separated Discord user IDs allowed to run /pause, /resume, /forcecycle.
# If unset, those control commands are refused for everyone.
DISCORD_OWNER_IDS=
