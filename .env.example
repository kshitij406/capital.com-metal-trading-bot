# Generate under "Manage API Access" in the OANDA account portal.
OANDA_API_TOKEN=
DISCORD_WEBHOOK_URL=
# true selects the practice host, false the live host. The account id is resolved
# dynamically from GET /v3/accounts, so it is never set here.
IS_DEMO=true

# Optional - defaults are the documented OANDA endpoints.
OANDA_PRACTICE_URL=https://api-fxpractice.oanda.com
OANDA_LIVE_URL=https://api-fxtrade.oanda.com

# Cap the balance used for position sizing. Practice accounts are funded at 100,000,
# which sizes nothing like a real account; 1000 keeps demo trades realistic.
BALANCE_CAP=1000

# discord_bot.py only (separate process, not used by bot.py)
DISCORD_BOT_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_ACCESS_TOKEN=
# Comma-separated Discord user IDs allowed to run /pause, /resume, /forcecycle.
# If unset, those control commands are refused for everyone.
DISCORD_OWNER_IDS=
